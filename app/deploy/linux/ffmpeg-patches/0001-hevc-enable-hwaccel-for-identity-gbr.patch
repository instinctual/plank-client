From: PLANK Engineering <engineering@instinctual.la>
Subject: [PATCH] avcodec/hevc: offer hardware formats for identity GBR

HEVC identity-matrix streams use GBRP/GBRP10 software formats but retain the
Main 4:4:4 hardware profile and coded layout. Add the aliases to get_format(),
not map_to_alpha_format(): only get_format() offers hardware accelerators.

--- a/libavcodec/hevc/hevcdec.c
+++ b/libavcodec/hevc/hevcdec.c
@@ -633,6 +633,7 @@ static enum AVPixelFormat get_format(HEVCContext *s, const HEVCSPS *sps)
         *fmt++ = AV_PIX_FMT_CUDA;
 #endif
         break;
+    case AV_PIX_FMT_GBRP:
     case AV_PIX_FMT_YUV444P:
 #if CONFIG_HEVC_VAAPI_HWACCEL
         *fmt++ = AV_PIX_FMT_VAAPI;
@@ -665,6 +666,7 @@ static enum AVPixelFormat get_format(HEVCContext *s, const HEVCSPS *sps)
         *fmt++ = AV_PIX_FMT_CUDA;
 #endif
         break;
+    case AV_PIX_FMT_GBRP10:
     case AV_PIX_FMT_YUV444P10:
 #if CONFIG_HEVC_VIDEOTOOLBOX_HWACCEL
         *fmt++ = AV_PIX_FMT_VIDEOTOOLBOX;
